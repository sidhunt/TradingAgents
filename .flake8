[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
per-file-ignores =
    __init__.py:F401
    tradingagents/__init__.py:F401
exclude =
    .git
    __pycache__
    .venv
    venv
    build
    dist
    .eggs
    *.egg
    .tox
    .pytest_cache
    .mypy_cache
    htmlcov
    .coverage
    migrations
    tests
